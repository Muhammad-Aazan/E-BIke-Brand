# ============================================================
# EVee Crown Motors API Backend — Environment Configuration
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORSED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- MongoDB Database ---
MONGODB_URI=mongodb://localhost:27017/evee_db
MONGODB_DB_NAME=evee_db

# --- JWT Secrets (Replace with random strings) ---
JWT_ACCESS_SECRET=evee_jwt_access_secret_super_secure_minimum_64_characters_long_key_2026
JWT_REFRESH_SECRET=evee_jwt_refresh_secret_super_secure_minimum_64_characters_long_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Cookie Signing Secret ---
COOKIE_SECRET=evee_secure_cookie_signing_secret_random_token_key_2026

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=200
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_CHECKOUT_MAX=10
RATE_LIMIT_SEARCH_MAX=60

# --- Payment Provider ---
PAYMENT_PROVIDER=stripe

# ============================================================
# REAL STRIPE CONFIGURATION
# ============================================================
# Get these keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=pkr
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel
STRIPE_API_VERSION=2025-06-30

# ============================================================
# REAL GMAIL SMTP OTP VERIFICATION
# ============================================================
# To send REAL emails to Gmail inboxes:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and the 16-character App Password below:
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=EVee Crown Motors
EMAIL_FROM_ADDRESS=your-email@gmail.com

# --- ImageKit Media CDN ---
IMAGEKIT_PUBLIC_KEY=public_9znI8VLlozVy8R6CJMqpY9tQuCU=
IMAGEKIT_PRIVATE_KEY=private_oLjGFIXZ5fI5412XlxDSMBXrKi0=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/qbwmuvvwo

# --- Store Settings ---
STORE_NAME=EVee
STORE_COMPANY=Crown Motors
STORE_CURRENCY=PKR
STORE_CURRENCY_SUBUNIT=100
STORE_LOCALE=en
STORE_COUNTRY=PK
STORE_SUPPORT_EMAIL=support@evee.pk

# --- Default Admin Seed Account ---
SEED_ADMIN_EMAIL=admin@evee.pk
SEED_ADMIN_PASSWORD=Admin@EVee2026!
SEED_ADMIN_NAME=EVee Admin

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs
