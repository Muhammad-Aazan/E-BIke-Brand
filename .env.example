# ============================================================
# EVee Backend — Environment Variables Template
# Crown Motors | Premium Electric Mobility
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- Server ---
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORSED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/evee_db
MONGODB_DB_NAME=evee_db

# --- JWT ---
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Cookies ---
COOKIE_SECRET=change_me_to_a_random_cookie_signing_secret

# --- Redis (optional - falls back to in-memory rate limiting if not set) ---
REDIS_URL=redis://localhost:6379

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CHECKOUT_MAX=5
RATE_LIMIT_SEARCH_MAX=30

# --- Payment Provider ---
# Options: stripe | cod
PAYMENT_PROVIDER=stripe

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=pkr
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel
STRIPE_API_VERSION=2025-06-30

# --- ImageKit (Media CDN & Storage) ---
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/...

# --- Cloudinary (Legacy/Alternative) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=evee_products

# --- Email / SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=EVee by Crown Motors
EMAIL_FROM_ADDRESS=noreply@evee.pk

# --- Store / Business ---
STORE_NAME=EVee
STORE_COMPANY=Crown Motors
STORE_CURRENCY=PKR
STORE_CURRENCY_SUBUNIT=100
STORE_LOCALE=en
STORE_COUNTRY=PK
STORE_SUPPORT_EMAIL=support@evee.pk
STORE_SUPPORT_PHONE=+92-XXX-XXXXXXX

# --- Admin Seed (development only) ---
SEED_ADMIN_EMAIL=admin@evee.pk
SEED_ADMIN_PASSWORD=change_me_before_production
SEED_ADMIN_NAME=EVee Admin

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs
